TELEGRAM_BOT_TOKEN=replace-with-a-token-from-BotFather
DATABASE_URL=sqlite:///./fifo_bot.db
LOG_LEVEL=INFO

# Optional: comma-separated Telegram user IDs. Leave blank to allow all users.
ALLOWED_TELEGRAM_USER_IDS=

# Owner controls are visible only to these immutable numeric Telegram IDs.
OWNER_TELEGRAM_USER_IDS=
BOT_OWNER_NAME=Administrator of @your_bot_username
SUPPORT_CONTACT=@your_bot_username

# Optional on-demand AI helper. Leave OPENAI_API_KEY blank to keep AI disconnected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_MAX_OUTPUT_TOKENS=450
